    <button @click="isOpen = !isOpen" x-show="!isOpen" x-transition.scale.origin.bottom
            class="w-16 h-16 bg-brand-orange text-white rounded-full shadow-xl flex items-center justify-center hover:scale-110 hover:bg-orange-600 transition-all duration-300 focus:outline-none">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
    </button>

</div>

<script>
    function chatBot() {
        return {
            isOpen: false,
            userInput: '',
            isLoading: false,
            messages: [
                { role: 'bot', text: 'Hello! I am the RoziTib Smart Assistant. How can I help you today?' }
            ],
            
            async sendMessage() {
                if (this.userInput.trim() === '') return;
                
                let msg = this.userInput;
                this.messages.push({ role: 'user', text: msg });
                this.userInput = '';
                this.isLoading = true;
                
                this.scrollToBottom();

                try {
                    let response = await fetch('/chat/send', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                        },
                        body: JSON.stringify({ message: msg })
                    });
                    
                    let data = await response.json();
                    
                    if(response.ok) {
                        this.messages.push({ role: 'bot', text: data.reply });
                    } else {
                        // Shows the exact backend error now
                        this.messages.push({ role: 'bot', text: data.reply || 'Sorry, there was a server error.' });
                    }
                } catch (error) {
                    this.messages.push({ role: 'bot', text: 'Network error. Please check your internet connection.' });
                } finally {
                    this.isLoading = false;
                    this.scrollToBottom();
                }
            },
            
            scrollToBottom() {
                setTimeout(() => {
                    let container = document.getElementById('chat-messages');
                    if(container) container.scrollTop = container.scrollHeight;
                }, 100);
            }
        }
    }
</script>

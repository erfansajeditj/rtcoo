                            @endphp

                            {{-- جادوی Alpine.js: مدیریت کامل اسلایدر --}}
                            <div x-data="{ 
                                    images: {{ json_encode($allImages) }},
                                    currentIndex: 0,
                                    timer: null,
                                    startTime: null,
                                    progress: 0,
                                    
                                    // تابع اصلی برای شروع اسلاید خودکار با شريط تقدم
                                    startAutoSlide() {
                                        if(this.images.length > 1) {
                                            clearInterval(this.timer);
                                            this.startTime = Date.now();
                                            this.progress = 0;
                                            
                                            this.timer = setInterval(() => {
                                                let elapsed = Date.now() - this.startTime;
                                                this.progress = (elapsed / {{ $slideDuration }}) * 100;
                                                
                                                if(this.progress >= 100) {
                                                    this.next();
                                                }
                                            }, 10); // بروزرسانی سریع برای حرکت نرم شريط
                                        }
                                    },
                                    
                                    // رفتن به عکس بعدی
                                    next() {
                                        this.currentIndex = (this.currentIndex + 1) % this.images.length;
                                        this.startAutoSlide(); // ریست تایمر
                                    },
                                    
                                    // برگشتن به عکس قبلی
                                    prev() {
                                        this.currentIndex = (this.currentIndex - 1 + this.images.length) % this.images.length;
                                        this.startAutoSlide(); // ریست تایمر
                                    },
                                    
                                    // انتخاب دستی کاربر از روی Thumbnails
                                    manualSelect(index) {
                                        this.currentIndex = index;
                                        this.startAutoSlide(); // ریست تایمر
                                    }
                                }" 
                                x-init="startAutoSlide()"
                                class="w-full relative group">
                                
<div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 mb-3 h-80 lg:h-[400px] flex flex-col items-center justify-center relative overflow-hidden group/main">
